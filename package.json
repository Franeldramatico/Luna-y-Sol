{
  "name": "luna-y-sol",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=3000 --host=0.0.0.0",
    "dev": "ng serve --port=3000 --host=0.0.0.0 --disable-host-check",
    "build": "ng build --base-href /Luna-y-Sol/",
    "build-gh": "ng build --base-href /Luna-y-Sol/ --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "predeploy": "npm run build-gh",
    "deploy": "ngh --dir=dist/app --branch=gh-pages"
  },
  "private": false,
  "homepage": "https://Franeldramatico.github.io/Luna-y-Sol/",
  "dependencies": {
    "@angular/cdk": "^21.0.0",
